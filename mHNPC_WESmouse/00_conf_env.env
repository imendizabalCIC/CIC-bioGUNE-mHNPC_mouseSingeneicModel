################################################################################
#| CONFIGURATION FILE MOUSE WES PIPELINE
################################################################################
#| Last update: 22/10/2026
#| Author: Ivana Rondon Lorefice
#|
#| Description:
#| This file defines the configuration parameters for the WESmouse
#| variant calling pipeline, including directory paths, reference files,
#| sample lists, analysis settings, and computational resources.
#|
#| Main settings:
#|   - Base directories, software environments, and reference files.
#|   - Tumor-normal matching and Panel of Normals (PON) options.
#|   - Sample lists for variant calling analysis.
#|   - CPU, memory, and runtime allocation for SLURM jobs.
#|
#| Notes:
#|   - Modify paths, samples, and resources according to the experiment.
################################################################################


# ===================================================
#  BASE DIRECTORIES
# ===================================================

BASE_DIR="/basedir/"
DATA_SHARED="/sharedir/"

R_BASE_DIR="~/"
R_DATA_SHARED="X:/sharedir/"

CONDA_ACTIVATE="/opt/ohpc/pub/apps/anaconda3/cic-env"
CONDA_ENV_WES="NewCluster_Software/conda_envs/WESenv"

JOBS_DIR="Scripts/jobs/"

R_LIBRARY_PATH="~/irondon/R_libraries"

# ===================================================
#  CONDITIONAL EXPERIMENT
# ===================================================
PON="Yes"
MATCH="Yes"

# ===================================================
#  FILE PATHS & DIRECTORIES
# ===================================================

# FASTQ Data
FASTQs_DIR="AC-82_WESmouse/FASTQs_trimmed/"

# Mapping directories
MARKED_DUPLICATES_DIR="02_Mapping/Marked_Duplicate_Metrics/"
RECALL_DIR="02_Mapping/Recal_Data_BQSR/"
MAPPED_DIRECTORY="02_Mapping/02_Mapped_Sequences/"
MAPPED_QC_DIRECTORY="02_Mapping/02_Mapped_Sequences_QC/"
COVERAGE_FILE="02_Mapping/02_Mapped_Sequences_QC/Read_Depth_Coverage_summary-d.txt"

# Genome reference
GENOME="Genomes_Rocky/Sequences/Mus_musculus.GRCm38.dna.primary_assembly.fa"
GENOME_DICT="Genomes_Rocky/Sequences/Mus_musculus.GRCm38.dna.primary_assembly.dict"
SNPS_INDELS_DATA="Genomes_Rocky/dbSNP_mouse/mgp.afonly.mm10.vcf.gz"
INTERVAL_LIST="Genomes_Rocky/WES_data/mm10/Twist_Mouse_Exome.interval_list"
BED_FILE="Genomes_Rocky/WES_data/mm10/Twist_Mouse_Exome_Chr_Modified_for_CODEX2.bed"

# Variance Effector Predictor (VEP)
CONDA_ENV_VEP="/fastdata/GPArkaitz_fastdata/irondon/conda_envs/vep_env"
VEP_DIR="/vols/GPArkaitz_bigdata/irondon/vep_data/"
SPECIE_VEP="mus_musculus"
DATASET_ENSEMBL="mmusculus_gene_ensembl"
VERSION_ENSEMBL="102"

# ===================================================
#  PANEL OF NORMALS (PON) and/OR MATCH DIR
# ===================================================

TUMOR_MATCH_DIR="03_SNVs_GATK/03_SNVs_step2_TUMOR-MATCH/"
TUMOR_MATCH_METRICS_DIR="03_SNVs_GATK/03_SNVs_step2_TUMOR-MATCH/03_SNVs_step2_1_TUMOR_METRICS_BCFTOOLS/"
TUMOR_MATCH_ANNOTATIONS_DIR="03_SNVs_GATK/03_SNVs_step2_TUMOR-MATCH/03_SNVs_step2_2_TUMOR_ANNOTATIONS_VEP/"

# ===================================================
#  SAMPLE LISTS
# ===================================================
NORMAL_MATCH_SAMPLES="B844"

TUMOR_MATCH_SAMPLES="332,338,J993,T051"

# ===================================================
#  RESOURCE ALLOCATION
# ===================================================
MAIL="irondon@cicbiogune.es"
CPU_MAPPING="4"
MEMORY_MAPPING="30G"
TIME_MAPPING="10:00:00"
PARTITION_MAPPING="NORMAL"

CPU_MUTECT2="4"
MEMORY_MUTECT2="10G"
TIME_MUTECT2="10:00:00"
PARTITION_MUTECT2="NORMAL"

CPU_PON="1"
MEMORY_PON="5G"
TIME_PON="3:00:00"
PARTITION_PON="NORMAL"